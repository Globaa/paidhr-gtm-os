{
  "title": "PaidHR GTM System",
  "subtitle": "Outbound, end to end. Draft design from context/docs/gtm-system.md. Row 1 reads left to right, row 2 right to left, row 3 left to right.",
  "rows": [
    {"title": "Find and qualify accounts", "direction": "ltr", "columns": ["1A", "1B", "1C", "1D", "1E", "1F", "1G", ["1H", "1I", "1J", "1K"]]},
    {"title": "Pick the people and write the message", "direction": "rtl", "columns": ["2A", "2B", "2C", "2D", "2E", "2F"]},
    {"title": "Send, sort replies and close", "direction": "ltr", "columns": ["3A", "3B", ["o1", "o2", "o3", "o4", "o5", "o6"], ["a1", "a2", "a3", "a4", "a5", "a6"], "3C", "3D", "3E", "3F", "3G"]}
  ],
  "nodes": {
    "1A": {"kind": "start", "title": "Context OS", "sub": "ICP, signal matrix, approved facts, workflow spec", "tools": ["claude_code", "github"], "w": 320},
    "1B": {"kind": "step", "title": "Buying signals", "sub": ["Hiring HR or payroll staff", "Frontline hiring 3+ posts", "Hiring in a 2nd country", "Firms selling payroll", "New HR or finance leader"], "tools": ["clay", "n8n"]},
    "1C": {"kind": "step", "title": "Find companies", "sub": "Clean domain, one row per company, deduped", "tools": ["clay"]},
    "1D": {"kind": "decision", "title": "In HubSpot?"},
    "excl1": {"kind": "exit", "title": "Exclude: customer or open deal", "below": "1D"},
    "1E": {"kind": "step", "title": "Enrich", "sub": "Headcount, industry, HQ, states, funding, ERP", "tools": ["clay"]},
    "1F": {"kind": "decision", "title": "ICP fit?"},
    "drop": {"kind": "exit", "title": "Drop, or hold if KE, GH, ZA", "below": "1F"},
    "1G": {"kind": "decision", "title": "Segment?"},
    "1H": {"kind": "branch", "title": "S1 Funded tech", "sub": "20 to 199 staff"},
    "1I": {"kind": "branch", "title": "S2 Frontline operators", "sub": "Logistics, retail, manufacturing"},
    "1J": {"kind": "branch", "title": "S3 Large employers", "sub": "200+ staff"},
    "1K": {"kind": "branch", "title": "S4 Payroll partners", "sub": "White-label"},
    "2A": {"kind": "step", "title": "Pick the angle", "sub": "First matching signal wins: 2nd country, manual payroll, new leader, multi-state", "tools": ["clay"], "w": 300},
    "2B": {"kind": "step", "title": "Find people", "sub": "Champion first, then economic buyer. Max 2 per account", "tools": ["clay"], "w": 280},
    "2C": {"kind": "step", "title": "Find and verify email", "sub": "Waterfall, own keys first", "tools": ["clay"]},
    "2D": {"kind": "decision", "title": "Email valid?"},
    "li": {"kind": "exit", "title": "LinkedIn-only track", "below": "2D"},
    "2E": {"kind": "decision", "title": "Contact clear?"},
    "excl2": {"kind": "exit", "title": "Exclude: unsubscribed or contacted recently", "below": "2E"},
    "2F": {"kind": "step", "title": "Write copy and QA", "sub": "Approved facts only, then campaign-qa", "tools": ["claude_code", "clay"], "w": 280},
    "3A": {"kind": "step", "title": "Send the sequence", "sub": ["Email: 3 to 4 steps over 14 days", "LinkedIn: request, 2 DMs, rep tasks"], "tools": ["plusvibe", "hubspot"], "w": 300},
    "3B": {"kind": "step", "title": "Sort replies", "sub": "AI tags the intent, other channel paused", "tools": ["n8n", "claude"]},
    "o1": {"kind": "branch", "title": "Interested", "h": 80},
    "o2": {"kind": "branch", "title": "Gives a date", "h": 80},
    "o3": {"kind": "branch", "title": "Wrong person", "h": 80},
    "o4": {"kind": "branch", "title": "Objection or other tool", "h": 80},
    "o5": {"kind": "branch", "title": "Unsubscribes", "h": 80},
    "o6": {"kind": "branch", "title": "No reply", "h": 80},
    "a1": {"kind": "step", "title": "Create deal, alert owner", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a2": {"kind": "step", "title": "Task on that date", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a3": {"kind": "exit", "title": "New contact, back to 2B", "w": 300, "h": 80},
    "a4": {"kind": "step", "title": "Owner answers, log it", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a5": {"kind": "exit", "title": "Suppress everywhere", "w": 300, "h": 80},
    "a6": {"kind": "exit", "title": "Wait for a new signal, back to 1B", "w": 300, "h": 80},
    "3C": {"kind": "step", "title": "Meeting booked", "w": 190, "h": 100, "tools": ["hubspot"]},
    "3D": {"kind": "step", "title": "Demo held", "w": 190, "h": 100},
    "3E": {"kind": "step", "title": "Proposal sent", "w": 190, "h": 100},
    "3F": {"kind": "step", "title": "Closed won or lost", "w": 190, "h": 100},
    "3G": {"kind": "start", "title": "Weekly review", "sub": "Results by signal, segment, angle. Learnings note, Context OS edits", "tools": ["n8n", "claude_code", "github"], "w": 320, "align": "bottom"}
  },
  "edges": [
    ["1A", "1B"], ["1B", "1C"], ["1C", "1D"],
    ["1D", "1E", "No"], ["1D", "excl1", "Yes"],
    ["1E", "1F"],
    ["1F", "1G", "Yes"], ["1F", "drop", "No"],
    ["1G", "1H"], ["1G", "1I"], ["1G", "1J"], ["1G", "1K"],
    ["1H", "2A"], ["1I", "2A"], ["1J", "2A"], ["1K", "2A"],
    ["2A", "2B"], ["2B", "2C"], ["2C", "2D"],
    ["2D", "2E", "Yes"], ["2D", "li", "No"],
    ["2E", "2F", "Yes"], ["2E", "excl2", "No"],
    ["2F", "3A"], ["3A", "3B"],
    ["3B", "o1"], ["3B", "o2"], ["3B", "o3"], ["3B", "o4"], ["3B", "o5"], ["3B", "o6"],
    ["o1", "a1"], ["o2", "a2"], ["o3", "a3"], ["o4", "a4"], ["o5", "a5"], ["o6", "a6"],
    ["a1", "3C"], ["3C", "3D"], ["3D", "3E"], ["3E", "3F"], ["3F", "3G"]
  ],
  "loop": {"from": "3G", "to": "1A", "label": "Weekly loop: results update the Context OS"}
}
